{
  "appId": "com.snacktime.pos",
  "appName": "Snack Time POS",
  "webDir": "dist",
  "loggingBehavior": "none",
  "server": { "androidScheme": "https", "cleartext": false, "errorPath": "webview-error.html" },
  "android": { "allowMixedContent": false, "webContentsDebuggingEnabled": false, "minWebViewVersion": 104, "backgroundColor": "#FBF6EE" },
  "plugins": {
    "CapacitorSQLite": { "androidIsEncryption": true },
    "SystemBars": { "insetsHandling": "native", "initialViewportFitValueHint": "contain", "style": "LIGHT" }
  }
}
