# Snack Time POS — PostgreSQL application settings
# Copy to backend/.env. Connection values may also live in ignored backend/.env.postgresql.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=snacktime_pos
PG_USER=postgres
PG_PASSWORD=replace_with_your_password
PG_ADMIN_DATABASE=postgres
PG_SSL=false
# PG_SSL_CA=C:/path/to/trusted-ca.pem
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
