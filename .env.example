# ==========================================
# FOODTRIP HOUSE POS - ENVIRONMENT VARIABLES
# Copy this file to backend/.env and fill in your own values
# ==========================================

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=foodtrip_house_pos

# Backend server
PORT=4000

# JWT auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Frontend origin allowed to call the API (for CORS)
CLIENT_ORIGIN=http://localhost:5173
